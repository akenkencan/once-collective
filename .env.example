# Copy values into Vercel environment settings or an ignored local .env.
# Never paste credentials into chat. Prefer a restricted Stripe API key.
ONCE_STRIPE_ENABLED=false
ONCE_STRIPE_MODE=sandbox
ONCE_PAYMENTS_ORIGIN=https://www.oncecollective.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ONCE_PAYMENTS_DATABASE_URL=
ONCE_PAYMENTS_TOKEN_SECRET=
# Generate one stable label with eight random lowercase letters, e.g. once_support_<suffix>.
ONCE_STRIPE_INTEGRATION_IDENTIFIER=
ONCE_STRIPE_PAYMENT_METHOD_CONFIGURATION=
ONCE_SELLER_EMAIL=
ONCE_SELLER_ADDRESS=
# Set only after sandbox acceptance, seller disclosures and live account verification.
ONCE_STRIPE_LIVE_APPROVED=false
